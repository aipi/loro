# syntax=docker/dockerfile:1
# Image used ONLY to run the Loro test suite reproducibly and headless (CI/local).
# It is NOT a deploy/release image — it does not build the GUI bundle. It COPIES
# the source (COPY works in DinD, unlike a bind-mount) and runs the Rust + JS tests.
#
# Base is the official Rust image; Node LTS and the Tauri Linux build deps are
# added so the `desktop` crate (which depends on tauri) compiles during tests.
FROM rust:1-slim

# Tauri v2 Linux system dependencies + toolchain for building native crates.
# (webkit2gtk / gtk / soup / alsa are pulled in transitively by the tauri crate.)
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      pkg-config \
      libssl-dev \
      libwebkit2gtk-4.1-dev \
      libgtk-3-dev \
      libsoup-3.0-dev \
      libasound2-dev \
      curl \
      ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rustup component add clippy rustfmt \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

# Default command: run the Rust backend tests and the JS frontend tests.
CMD sh -c "cd desktop/src-tauri && cargo test && cd /app/desktop && node --test tests/*.test.js"
